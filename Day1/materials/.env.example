# =============================================================
# UNDP IICPSD Agentic AI & Vibe Coding Training Series 2026
# Environment Variables Template
# Instructor: Phyo Ko Ko, Senior Cyber Security Analyst
# =============================================================
#
# INSTRUCTIONS:
#   1. Copy this file and rename it to  .env
#   2. Fill in your real values (never share or commit .env)
#   3. Load in Python with:  pip install python-dotenv
#      Then in your script:  from dotenv import load_dotenv; load_dotenv()
#      Access values with:   import os; os.environ.get('VARIABLE_NAME')
# =============================================================


# -------------------------------------------------------------
# AI MODEL PROVIDERS
# -------------------------------------------------------------

# Anthropic (Claude) — used in Labs 1, 4, and Module 5
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI — optional alternative model provider
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# IBM watsonx — enterprise AI platform (optional)
# Get credentials at: https://cloud.ibm.com/catalog/services/watsonx-ai
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com


# -------------------------------------------------------------
# DATABASE (Module 5 — real deployment scenario)
# -------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DB_URI=postgresql://your_user:your_password@localhost:5432/your_database

# Individual fields (alternative to connection string)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password


# -------------------------------------------------------------
# MCP SERVER (Module 4)
# -------------------------------------------------------------

# Port the local MCP server listens on
MCP_SERVER_PORT=8000

# Secret used to authenticate agent-to-server requests
MCP_SERVER_SECRET=your_mcp_server_secret_here


# -------------------------------------------------------------
# NOTIFICATIONS & INTEGRATIONS (optional)
# -------------------------------------------------------------

# Slack webhook — used in the send_notification MCP tool
# Create one at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email sender (for notification agents)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here


# -------------------------------------------------------------
# SECURITY SCANNING (Module 3)
# -------------------------------------------------------------

# TruffleHog — no API key needed for local use
# Bandit — no API key needed for local use

# If using a remote scanning service (e.g. Jit.io, Snyk)
SNYK_TOKEN=your_snyk_token_here


# -------------------------------------------------------------
# GENERAL
# -------------------------------------------------------------

# Set to 'development' during training, 'production' for real deployments
# NEVER set DEBUG=True in production
APP_ENV=development
DEBUG=False
